@echo off
setlocal
if exist "%~dp0install-qwen-t2i-test-models.ps1" if exist "%~dp0verified-model-download.ps1" if exist "%~dp0qwen-t2i-test-downloads.json" goto repo
set "ULTRA_STUDIO_BATCH_PATH=%~f0"
echo Standalone installer: downloads or recovers both AGQI FP8 and Rapid AIO v23.
if not "%~1"=="" echo Optional flags require the full repository scripts. Standalone mode uses Both.
powershell.exe -NoProfile -ExecutionPolicy Bypass -Command "$ErrorActionPreference='Stop'; $taskExit=0; $taskDir=Join-Path ([IO.Path]::GetTempPath()) ('UltraStudio-Qwen-'+[Guid]::NewGuid().ToString('N')); try { $taskText=[IO.File]::ReadAllText($env:ULTRA_STUDIO_BATCH_PATH); $taskMatch=[regex]::Match($taskText,'(?m)^::ULTRA_STUDIO_PAYLOAD::([A-Za-z0-9+/=]+)\r?$'); if(-not $taskMatch.Success){throw 'Installer payload is missing.'}; New-Item -ItemType Directory -Path $taskDir | Out-Null; $taskZip=Join-Path $taskDir 'installer.zip'; [IO.File]::WriteAllBytes($taskZip,[Convert]::FromBase64String($taskMatch.Groups[1].Value)); Add-Type -AssemblyName System.IO.Compression.FileSystem; [IO.Compression.ZipFile]::ExtractToDirectory($taskZip,$taskDir); & (Join-Path $taskDir 'install-qwen-t2i-test-models.ps1') } catch { Write-Host $_.Exception.Message -ForegroundColor Red; $taskExit=1 } finally { if(Test-Path -LiteralPath $taskDir){Remove-Item -LiteralPath $taskDir -Recurse -Force -ErrorAction SilentlyContinue} }; exit $taskExit"
set "task_exit=%ERRORLEVEL%"
goto done
:repo
powershell.exe -NoProfile -ExecutionPolicy Bypass -File "%~dp0install-qwen-t2i-test-models.ps1" %*
set "task_exit=%ERRORLEVEL%"
:done
if not "%task_exit%"=="0" echo Installation did not complete. Read the error above.
pause
exit /b %task_exit%
::ULTRA_STUDIO_PAYLOAD::
